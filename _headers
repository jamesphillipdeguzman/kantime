# Netlify _headers — KanTimes PWA Cache-Control & Service Worker Rules
# Prevents browsers and Netlify CDN edge caches from serving stale
# versions of the files that control the PWA update lifecycle.

/sw.js
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate
  Pragma: no-cache
  Service-Worker-Allowed: /

/index.html
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate
  Pragma: no-cache

/manifest.json
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8
  Access-Control-Allow-Origin: *

/version.json
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate
  Content-Type: application/json; charset=utf-8
  Pragma: no-cache
  Access-Control-Allow-Origin: *

/script.js
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate
  Pragma: no-cache

/css/style.css
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate
  Pragma: no-cache

